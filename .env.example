# Copy to `.env` and fill in. `.env` is gitignored — the key never
# leaves your machine. The server reads this file directly (Node 24's
# built-in --env-file, see package.json); there is no dotenv dependency.
#
# The key is SERVER-ONLY. The browser never sees it — it calls
# /api/voice/token and gets a short-lived streaming token instead.
# Get one at https://www.assemblyai.com/dashboard/api-keys

ASSEMBLYAI_API_KEY=

# --- optional, sane defaults below ---

# Streaming model. universal-3-5-pro is the current realtime flagship.
AAI_STREAMING_MODEL=universal-3-5-pro

# How long a minted token stays redeemable (1-600). Short is fine: it
# only has to survive the hop from fetch to WebSocket open.
AAI_TOKEN_TTL_SECONDS=60

# Max length of a streaming session once opened (60-10800). Default 5400.
#
# A cost guard against ABANDONED sessions, not a limit on real ones.
# Streaming bills on how long the socket stays OPEN, idle or not, and a tab
# that closes without sending Terminate keeps billing until the session
# times out: $1.35 of universal-3-5-pro at the 3h ceiling, $0.68 at 90 min.
#
# Don't set this tight. There is no reconnect (see ws.onclose in
# useStreamingTranscript.js) — hitting the cap kills the mic mid-cook and
# the only way back is toggling mute, with no explanation on screen. The
# socket also only lives while unmuted, so this is unmuted time, not cook
# time, and 90 min is already slack for the ~90 min cook this targets.
AAI_MAX_SESSION_SECONDS=5400

# Browser origins allowed to call this API. Empty = allow any, which is
# right for local dev (Vite proxies, so it is same-origin anyway). The
# deployed API needs the Pages origin: scheme and host ONLY — a path like
# /goose-goose-cook is not part of an origin and would never match.
# ALLOWED_ORIGINS=https://ziqing110.github.io

# Model used to read conversation answers via the LLM Gateway.
#
# Chosen by measurement, not reputation. This is a small job with a
# person waiting on it, so speed counts as much as accuracy. Over ten
# known-answer cases:
#
#   gemini-2.5-flash-lite   10/10    654ms   (cheapest)
#   gemini-3.5-flash-lite   10/10    896ms
#   claude-sonnet-4-6       10/10   1291ms   <- in use
#   claude-haiku-4-5         9/10   3462ms
#
# Sonnet is in use for capability on messy real speech, which ten cases
# cannot measure. Switch to gemini-2.5-flash-lite for half the latency
# and a fraction of the cost; no code change needed.
#
# Models WITHOUT response_format support, which this needs: Sonnet 5,
# Opus 5, Opus 4.7/4.8, GPT-4.1, gpt-oss-20b, qwen3.5-4b. The GPT-5
# family accepts it but is a reasoning model: it spends the whole token
# budget thinking and returns an empty string unless max_tokens is large.
AAI_LLM_GATEWAY_MODEL=claude-sonnet-4-6

# Model used to generate recipe graphs. A big structured job behind a
# loading state, so it can afford a large model where the per-answer
# reader above cannot.
#
# NOT claude-sonnet-5 or claude-opus-5: neither supports response_format
# on the gateway (they take `tools` instead), and a recipe graph has far
# too much structure to ask for in prose. Verified against the live
# account, not just the docs table.
AAI_RECIPE_MODEL=gemini-3.8-flash

# Used when AAI_RECIPE_MODEL is not reachable — a free-tier account has
# this and nothing else, and a 400 'does not have access' is the shape
# that takes.
#
# It cannot do the primary's job. Given three dishes in one call it
# either merged them into a single recipe or ran out of tokens after
# emitting 226 materials and no recipes at all. It has no response_format
# either. So the server asks it for ONE DISH AT A TIME and merges the
# results, which it handles reliably in about four seconds each.
#
# The cost is visible in the product: nothing is ever shared, because no
# single call sees two dishes. The response says sharedStepsPossible
# false when this ran.
AAI_RECIPE_FALLBACK_MODEL=qwen3.5-4b-32k-fast

# A second pass reads the generated plan back before anyone cooks it,
# and returns corrections rather than a new plan — so it can only
# improve things or leave them alone.
#
# Deliberately a DIFFERENT model from the generator. Given a plan with
# four planted faults, Sonnet 4.6 found all four, including a
# mouth-watering chicken served without its chill — the same mistake
# Sonnet makes when it is the one generating. Both Gemini models found
# only the implausible duration. Writing a plan and reading one back are
# not the same skill.
AAI_RECIPE_REVIEW_MODEL=claude-sonnet-4-6

# Set to off to skip the review pass — it costs a second model call on a
# generation the cook is already waiting through.
# AAI_RECIPE_REVIEW=off

# Model for the live-cook agent's turns (tool calls + spoken reply). It
# must support `tools`, and a cook is waiting on it, so speed leads.
# Gateway streaming is OpenAI-only, so replies arrive whole. Calibrate
# against the fixtures before changing this.
AAI_AGENT_MODEL=gpt-4.1

# Lets the live-cook agent look up a cooking question the recipe does
# not answer ("can I use a shallot", "my sauce is too salty"). OPTIONAL:
# with no key the search tool is never offered to the model and the
# agent behaves exactly as it did before — nothing fails at cook time.
#
# The LLM Gateway has no web search of its own; `search_web` in
# AssemblyAI's agentic-workflows example is a function you implement,
# and server/agent/search.js is ours. Tavily returns a synthesized
# answer rather than ten links, which suits a 30-word spoken reply.
# Free tier at https://tavily.com is ample for a hackathon.
#
# A turn that searches costs two model calls plus a lookup. It does NOT
# block the cook: the first response comes back at once with anything the
# agent already decided plus "let me look that up", and the answer is
# collected separately, off the turn queue. Commands given while Goose is
# reading land normally. See server/agent/pending.js.
TAVILY_API_KEY=

# Model for the unprompted remarks the agent makes into a quiet kitchen
# (server/agent/aside.js). A garnish: it must never compete for latency
# with a cook who actually asked for something, and every failure is
# simply silence, so this is the cheapest thing that can write a
# sentence.
AAI_ASIDE_MODEL=gemini-2.5-flash-lite

# Model that writes up how a finished cook went, for the summary card
# (server/agent/narrate.js). Runs once per run, after the cooking, with
# nobody waiting on a hot pan — the one call in this app where a slower,
# better model is the right trade. An empty answer just leaves the card
# with the deterministic headline it always had.
AAI_NARRATE_MODEL=claude-sonnet-4-6
