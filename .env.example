# Copy to `.env` and fill in. `.env` is gitignored — the key never
# leaves your machine. The server reads this file directly (Node 24's
# built-in --env-file, see package.json); there is no dotenv dependency.
#
# The key is SERVER-ONLY. The browser never sees it — it calls
# /api/voice/token and gets a short-lived streaming token instead.
# Get one at https://www.assemblyai.com/dashboard/api-keys

ASSEMBLYAI_API_KEY=

# --- optional, sane defaults below ---

# Streaming model. universal-3-5-pro is the current realtime flagship.
AAI_STREAMING_MODEL=universal-3-5-pro

# How long a minted token stays redeemable (1-600). Short is fine: it
# only has to survive the hop from fetch to WebSocket open.
AAI_TOKEN_TTL_SECONDS=60

# Max length of a streaming session once opened (60-10800). A long cook
# is ~90 min; 3h is the API ceiling and also the default.
AAI_MAX_SESSION_SECONDS=10800

# Model used to read conversation answers via the LLM Gateway.
#
# Chosen by measurement, not reputation. This is a small job with a
# person waiting on it, so speed counts as much as accuracy. Over ten
# known-answer cases:
#
#   gemini-2.5-flash-lite   10/10    654ms   (cheapest)
#   gemini-3.5-flash-lite   10/10    896ms
#   claude-sonnet-4-6       10/10   1291ms   <- in use
#   claude-haiku-4-5         9/10   3462ms
#
# Sonnet is in use for capability on messy real speech, which ten cases
# cannot measure. Switch to gemini-2.5-flash-lite for half the latency
# and a fraction of the cost; no code change needed.
#
# Models WITHOUT response_format support, which this needs: Sonnet 5,
# Opus 5, Opus 4.7/4.8, GPT-4.1, gpt-oss-20b, qwen3.5-4b. The GPT-5
# family accepts it but is a reasoning model: it spends the whole token
# budget thinking and returns an empty string unless max_tokens is large.
AAI_LLM_GATEWAY_MODEL=claude-sonnet-4-6

# Model used to generate recipe graphs. A big structured job behind a
# loading state, so it can afford a large model where the per-answer
# reader above cannot.
#
# NOT claude-sonnet-5 or claude-opus-5: neither supports response_format
# on the gateway (they take `tools` instead), and a recipe graph has far
# too much structure to ask for in prose. Verified against the live
# account, not just the docs table.
AAI_RECIPE_MODEL=claude-sonnet-4-6
