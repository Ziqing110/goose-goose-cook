{
  "name": "kitchen-path",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file-if-exists=.env server/index.js",
    "agent:calibrate": "node --env-file-if-exists=.env server/agent/calibrate.mjs",
    "dev:full": "concurrently -n web,api -c blue,green \"npm:dev\" \"npm:server\"",
    "dev:voice": "concurrently -n web,api,speaker -c blue,green,magenta \"npm:dev\" \"npm:server\" \"npm:speaker\"",
    "build": "vite build",
    "preview": "vite preview",
    "tts-lab": "node tts-lab/server.js",
    "speaker": ".venv-voice\\Scripts\\python.exe speaker-sidecar/server.py",
    "lint": "eslint . --ext .js,.jsx --max-warnings 0",
    "test": "node --test src/utils/*.test.js server/**/*.test.js",
    "test:e2e": "node scripts/livecook-e2e.mjs",
    "test:voice-e2e": "node scripts/voice-commands-e2e.mjs",
    "speaker:eval": "node scripts/speaker-eval.mjs",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.5",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "playwright": "^1.63.0",
    "vite": "^5.4.6"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
